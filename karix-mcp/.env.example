# Karix MCP Server — Environment Variables
# Copy to .env and fill in your values.
# Never commit .env to version control.

# ── Karix Account ─────────────────────────────────────────────────────────────
KARIX_API_KEY=             # Karix API key (Authentication: Bearer header)
KARIX_WABA_ID=             # WhatsApp Business Account ID
KARIX_SENDER_ID=           # Sender phone number in E.164 without + (e.g. 919152004195)
KARIX_ESME_ADDR=           # ESME address for account lookup (e.g. 71226600000018)

# ── Karix API Endpoints ───────────────────────────────────────────────────────
KARIX_SEND_BASE_URL=https://rcmapi.instaalerts.zone
KARIX_TEMPLATE_BASE_URL=https://rcsgui.karix.solutions

# ── Server ────────────────────────────────────────────────────────────────────
MCP_PORT=8001

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret used to sign JWTs issued by POST /oauth/token.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ── MySQL (Template Studio — drafts + bulk-import job tracking only) ──────────
# Approved/live templates are never stored here; they stay live-sourced from
# Karix's own Template API. Run schema.sql once against this database.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=karix_mcp_db
