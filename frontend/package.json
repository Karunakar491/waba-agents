{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "jest",
    "e2e": "playwright test --grep-invert \"@walk|@walk2|@walk3|@shots\"",
    "e2e:headed": "playwright test --headed --grep-invert \"@walk|@walk2|@walk3|@shots\"",
    "e2e:report": "playwright show-report e2e-report",
    "e2e:audit": "playwright test --grep \"@walk|@walk2|@walk3|@shots\""
  },
  "dependencies": {
