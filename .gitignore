# Build outputs
backend/target/
frontend/node_modules/
frontend/dist/

# IDE
.idea/
*.iml
.vscode/

# Secrets / local config
*.pem
*.key
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# Large binaries
*.exe
*.zip
*.tar.gz

# Claude internal. Excluded per-entry, not as a directory: git does not descend
# into an excluded directory, so a `.claude/` rule makes every negation below
# it dead letter.
.claude/*
# ...except the enforcement config. Hooks must be tracked so that weakening
# one shows up as a reviewable diff rather than a silent local change.
!.claude/settings.json
# Reviewers are part of the harness for the same reason: loosening a review
# standard should be a diff someone can read, not a local file nobody sees.
!.claude/agents/
.claude/agents/*
!.claude/agents/*.md

.superpowers/

# Postman (contains tokens)
*.json.bak

# Local secret material — never committed
.local-keys/

# JVM crash artifacts
hs_err_pid*.log
replay_pid*.log

# Local Playwright test scaffold (audit tooling, not product code)
/pw/

# Git worktrees for isolated feature work (superpowers:using-git-worktrees)
/.worktrees/

# Playwright output — traces and screenshots, regenerated on every run
frontend/e2e-report/
frontend/e2e-walk/
frontend/test-results/

# Seeded design-canvas payload — a 2MB build artifact; the .dc.html sources beside it are the source of truth
design/connector-section.html

# Design artboards are generated — `node screens.mjs && node connectors.mjs`. The generators are the source.
design/*.dc.html
