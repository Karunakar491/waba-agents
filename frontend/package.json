    "autoprefixer": "^10.5.4",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.20",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
